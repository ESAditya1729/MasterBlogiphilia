# MongoDB connection string (Atlas or local)
MONGO_URI=

# Secret used to sign JWT auth tokens
JWT_SECRET=

# Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Full Google Gemini generateContent URL including API key (used by the "Ask Lilly" assistant)
Lilly_API_URL=

# Optional - server port (defaults to 1000)
# PORT=1000
